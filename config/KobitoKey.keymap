#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// OS設定を日本語キーボードのまま使用するための変換定義

#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          0x89              // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   LS(0x87)          // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角

/ {
    combos {
        compatible = "zmk,combos";

        combo_eisu {
            timeout-ms = <50>;
            key-positions = <12 13>;
            bindings = <&kp LANG2>;
        };

        combo_kana {
            timeout-ms = <50>;
            key-positions = <16 17>;
            bindings = <&kp LANG1>;
        };

        combo_esc {
            timeout-ms = <50>;
            key-positions = <0 1>;
            bindings = <&kp ESC>;
        };

        combo_tab {
            timeout-ms = <50>;
            key-positions = <10 11>;
            bindings = <&kp TAB>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W          &kp E          &kp R      &kp T        &mt HOME Y  &kp U      &kp I          &kp O                 &lt 3 P
&mt A LEFT_GUI    &kp S          &kp D          &kp F      &kp G        &mt END H   &kp J      &kp K          &kp L                 &lt 4 MINUS
&mt LEFT_SHIFT Z  &kp X          &kp C          &kp V      &kp B        &kp N       &kp M      &kp COMMA      &kp DOT               &kp RIGHT_SHIFT
&kp LEFT_CONTROL  &kp LS(LG(S))  &lt 1 JP_EISU  &kp SPACE  &lt 2 ENTER  &kp BSPC    &lt 5 TAB  &lt 6 JP_KANA  &mt RIGHT_ALT ESCAPE  &kp RIGHT_CONTROL
            >;
        };

        layer1 {
            label = "NUMBER";
            bindings = <
&kp JP_COLON             &kp F7  &kp F8  &kp F9  &kp F12  &kp SLASH     &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp JP_PLUS
&kp SEMICOLON            &kp F4  &kp F5  &kp F6  &kp F11  &kp JP_CARET  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp MINUS
&mt LEFT_SHIFT JP_EQUAL  &kp F1  &kp F2  &kp F3  &kp F10  &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &mt RIGHT_SHIFT JP_ASTERISK
&trans                   &trans  &trans  &trans  &trans   &trans        &trans        &trans        &trans        &trans
            >;
        };

        layer2 {
            label = "ARROW";
            bindings = <
&none           &none           &kp UP_ARROW    &none            &none   &kp BACKSLASH      &kp JP_QUOTE     &kp JP_LPAREN  &kp JP_RPAREN     &kp JP_AT
&kp LEFT_GUI    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &none   &kp JP_UNDERSCORE  &kp DOLLAR       &kp PERCENT    &kp JP_AMPERSAND  &kp JP_TILDE
&kp LEFT_SHIFT  &none           &none           &none            &none   &kp QUESTION       &kp EXCLAMATION  &kp JP_DQUOTE  &kp HASH          &kp RIGHT_SHIFT
&trans          &trans          &trans          &trans           &trans  &kp DELETE         &trans           &trans         &trans            &trans
            >;
        };

        layer3 {
            label = "MOUSE";
            bindings = <
&none           &none   &none   &none   &none   &mkp MB1  &mkp MB3  &mkp MB2  &none   &none
&kp LEFT_GUI    &none   &none   &none   &none   &mkp MB4  &mkp MB5  &none     &none   &mo 4
&kp LEFT_SHIFT  &none   &none   &none   &none   &none     &none     &none     &none   &kp RIGHT_SHIFT
&trans          &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans  &trans
            >;
        };

        layer_4 {
            label = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        layer_5 {
            label = "BRACKETS";
            bindings = <
&none           &none   &none   &none   &none   &none   &kp JP_LBRACE    &kp JP_RBRACE    &none   &none
&kp LEFT_GUI    &none   &none   &none   &none   &none   &kp JP_LBRACKET  &kp JP_RBRACKET  &none   &none
&kp LEFT_SHIFT  &none   &none   &none   &none   &none   &none            &none            &none   &kp RIGHT_SHIFT
&trans          &trans  &trans  &trans  &trans  &trans  &trans           &trans           &trans  &trans
            >;
        };

        layer_6 {
            label = "BLUETOOTH";
            bindings = <
&none  &none  &none  &none  &none  &none         &none         &none         &none         &none
&none  &none  &none  &none  &none  &none         &none         &none         &none         &none
&none  &none  &none  &none  &none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&none  &none  &none  &none  &none  &none         &none         &none         &none         &none
            >;
        };
    };
};
